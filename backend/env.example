# Copy to backend/.env for local development. All values below are required
# except CORS_ORIGINS, which defaults to "*".

# MongoDB connection string (e.g. from MongoDB Atlas).
MONGO_URL=mongodb://localhost:27017
DB_NAME=bitnex

# Secret used to sign auth tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me

# Seeds the initial admin account on first run.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-me

# Comma-separated allowed origins. Because the API sends credentials,
# this must name the exact frontend origin - "*" will be rejected.
CORS_ORIGINS=http://localhost:3000
